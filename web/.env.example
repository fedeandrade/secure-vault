# Copie para `web/.env` e preencha. O `.gitignore` do web ignora `.env*` e abre
# exceção só para este arquivo.
#
# ⚠️ Este NÃO é o `.env` da raiz. O lado Python usa o esquema
# `postgresql+psycopg://` (driver do SQLAlchemy); o `pg`, que o Prisma usa por
# baixo, não entende esse esquema e falha na conexão. Aqui é `postgresql://`.
DATABASE_URL=postgresql://<USUARIO>:<SENHA>@localhost:5433/secure_vault_web

# Fase 1. Exigido com >= 32 bytes DEPOIS de decodificar — `changeme` passaria
# numa checagem de presença. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=<GERE_UM_SEGREDO_DE_32_BYTES>
