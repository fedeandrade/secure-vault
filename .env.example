# Copie este arquivo para .env e preencha com seus valores locais.
# NUNCA commite o .env de verdade — ele está no .gitignore.

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# Lidas pelo docker-compose.yml para inicializar o container do Postgres.
POSTGRES_USER=vault
POSTGRES_PASSWORD=troque-por-uma-senha-local
POSTGRES_DB=secure_vault
POSTGRES_PORT=5432

# Lida pela aplicação (SQLAlchemy). Precisa bater com os valores acima.
# +psycopg = driver psycopg v3, não o psycopg2 clássico.
# Se a senha tiver caracteres especiais (@ : / ?), codifique-os em percent-encoding.
DATABASE_URL=postgresql+psycopg://vault:troque-por-uma-senha-local@localhost:5432/secure_vault

# ---------------------------------------------------------------------------
# Derivação de chave (Argon2id)
# ---------------------------------------------------------------------------
# Estes valores valem apenas para vaults NOVOS. Um vault já criado guarda os
# próprios parâmetros no banco e continua abrindo com eles — mudar aqui não
# quebra nada que já exista. Ver docs/TUTORIAL.md, seção "Parâmetros do KDF".
#
# Piso recomendado pelo RFC 9106 para uso interativo. Suba se a sua máquina
# aguentar: meça com `uv run python -m timeit -n 5 -s "..."` antes de mudar.
KDF_ALGORITHM=argon2id
KDF_TIME_COST=3
KDF_MEMORY_COST=65536
KDF_PARALLELISM=4

# ---------------------------------------------------------------------------
# Interface
# ---------------------------------------------------------------------------
# Inatividade máxima do `vault shell` e da TUI antes de descartar a chave.
SESSION_TIMEOUT_SECONDS=300

# Quanto tempo uma senha copiada permanece na área de transferência.
CLIPBOARD_CLEAR_SECONDS=20

# ---------------------------------------------------------------------------
# Apenas para testes automatizados — NÃO defina no seu .env de uso diário
# ---------------------------------------------------------------------------
# Banco usado pelos testes marcados @pytest.mark.postgres. Sem ela, esses testes
# são pulados e a suíte roda inteira em SQLite temporário.
# TEST_DATABASE_URL=postgresql+psycopg://vault:senha@localhost:5432/secure_vault
